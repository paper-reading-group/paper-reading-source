.member-list {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
  gap: 1rem;
  margin-top: 2rem;
}

.member-card {
  background: var(--card-background);
  border-radius: 12px;
  padding: 1.5rem;
  text-align: center;
  box-shadow: 0 2px 8px rgba(0,0,0,0.1);
  transition: transform 0.2s;
}

.member-card:hover {
  transform: translateY(-4px);
}

.member-avatar {
  border-radius: 50%;
  width: 80px;
  height: 80px;
  object-fit: cover;
  margin-bottom: 1rem;
}

.member-links a {
  margin: 0 8px;
  font-size: 1.2rem;
  color: var(--link-color);
  text-decoration: none;
}

.timeline {
  margin-top: 2rem;
}
.timeline-year {
  border-bottom: 2px solid var(--text-color);
  padding-bottom: 0.5rem;
}
.timeline-month {
  margin: 1.5rem 0 0.5rem;
  color: var(--secondary-text-color);
  font-weight: 400;
}
.timeline-item {
  padding: 0.4rem 0;
  display: flex;
  align-items: baseline;
  gap: 1rem;
}
.timeline-date {
  min-width: 70px;
  color: var(--secondary-text-color);
  font-size: 0.9rem;
}
.timeline-category {
  margin-left: auto;
  font-size: 0.8rem;
}

.prg-site-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  width: 100%;
}

.prg-site-nav .menu {
  flex: 1 1 auto;
}

.prg-nav-search {
  flex: 0 0 280px;
}

.prg-nav-search-trigger {
  align-items: center;
  background: rgba(255, 255, 255, 0.08);
  border: 1px solid rgba(148, 163, 184, 0.22);
  border-radius: 999px;
  color: var(--text-color);
  display: flex;
  gap: 0.5rem;
  justify-content: flex-start;
  padding: 0.55rem 1rem;
  transition: all 0.2s ease;
}

.prg-nav-search-trigger:hover {
  background: rgba(59, 130, 246, 0.12);
  border-color: rgba(96, 165, 250, 0.42);
  color: var(--text-color);
}

.site-nav .menu {
  display: flex;
  flex-wrap: wrap;
  gap: 0.3rem 0.8rem;
}

.site-nav .menu-item-search {
  margin-left: auto;
}

.site-nav .menu-item-search .popup-trigger {
  align-items: center;
  background: rgba(255, 255, 255, 0.08);
  border: 1px solid rgba(148, 163, 184, 0.22);
  border-radius: 999px;
  display: inline-flex;
  gap: 0.4rem;
  justify-content: flex-start;
  min-width: 280px;
  padding: 0.5rem 1rem;
}

.site-nav .menu-item-search .popup-trigger:hover {
  background: rgba(59, 130, 246, 0.12);
  border-color: rgba(96, 165, 250, 0.42);
}

.site-nav-right {
  display: none;
}

.prg-home-page {
  width: 100%;
}

.prg-home {
  display: flex;
  flex-direction: column;
  gap: 2rem;
  padding-bottom: 3rem;
}

.prg-hero-card {
  background: linear-gradient(135deg, #111827 0%, #172554 48%, #1e293b 100%);
  border-radius: 28px;
  color: #f8fafc;
  display: grid;
  gap: 2rem;
  grid-template-columns: minmax(0, 1.2fr) minmax(320px, 0.8fr);
  overflow: hidden;
  padding: 2.5rem;
  position: relative;
}

.prg-hero-card::before {
  background: radial-gradient(circle at top left, rgba(96, 165, 250, 0.22), transparent 34%);
  content: '';
  inset: 0;
  position: absolute;
}

.prg-hero-copy,
.prg-hero-visual {
  position: relative;
  z-index: 1;
}

.prg-eyebrow {
  color: #bfdbfe;
  display: inline-block;
  font-size: 0.95rem;
  letter-spacing: 0.08em;
  margin-bottom: 1rem;
  text-transform: uppercase;
}

.prg-hero-card h1 {
  color: #fff;
  font-size: 2.8rem;
  line-height: 1.15;
  margin: 0 0 1rem;
}

.prg-hero-desc {
  color: #dbeafe;
  font-size: 1.05rem;
  line-height: 1.8;
  margin: 0;
  max-width: 680px;
}

.prg-hero-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 0.9rem;
  margin-top: 1.5rem;
}

.prg-btn {
  border-radius: 999px;
  display: inline-flex;
  font-weight: 600;
  padding: 0.75rem 1.35rem;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.prg-btn:hover {
  box-shadow: 0 10px 24px rgba(15, 23, 42, 0.18);
  transform: translateY(-2px);
}

.prg-btn-primary {
  background: #fff;
  color: #1d4ed8;
}

.prg-btn-primary:hover {
  color: #1d4ed8;
}

.prg-btn-secondary {
  background: rgba(15, 23, 42, 0.26);
  border: 1px solid rgba(255, 255, 255, 0.16);
  color: #fff;
}

.prg-btn-secondary:hover {
  color: #fff;
}

.prg-hero-stats {
  display: flex;
  flex-wrap: wrap;
  gap: 1rem;
  margin-top: 2rem;
}

.prg-stat {
  background: rgba(15, 23, 42, 0.28);
  border: 1px solid rgba(255, 255, 255, 0.10);
  border-radius: 18px;
  min-width: 118px;
  padding: 0.95rem 1.1rem;
}

.prg-stat strong {
  color: #fff;
  display: block;
  font-size: 1.6rem;
}

.prg-stat span {
  color: #cbd5e1;
  font-size: 0.95rem;
}

.prg-hero-image {
  align-items: center;
  background: linear-gradient(160deg, rgba(14, 165, 233, 0.26), rgba(124, 58, 237, 0.24));
  border: 1px dashed rgba(255, 255, 255, 0.28);
  border-radius: 24px;
  display: flex;
  flex-direction: column;
  height: 100%;
  justify-content: center;
  min-height: 280px;
  padding: 2rem;
  text-align: center;
}

.prg-hero-image span {
  color: #fff;
  font-size: 1.2rem;
  font-weight: 600;
}

.prg-hero-image small {
  color: #dbeafe;
  display: block;
  font-size: 0.95rem;
  margin-top: 0.6rem;
  max-width: 260px;
}

.prg-section {
  background: var(--content-bg-color);
  border-radius: 24px;
  padding: 2rem;
}

.prg-section-head {
  align-items: end;
  display: flex;
  flex-wrap: wrap;
  gap: 0.75rem 1.25rem;
  justify-content: space-between;
  margin-bottom: 1.4rem;
}

.prg-section-head h2,
.prg-meta-card h3,
.prg-entry-card h3,
.prg-paper-card h3 {
  margin: 0;
}

.prg-section-head p,
.prg-entry-card p,
.prg-paper-excerpt {
  margin: 0;
}

.prg-entry-grid,
.prg-paper-grid,
.prg-meta-grid {
  display: grid;
  gap: 1.25rem;
}

.prg-entry-grid {
  grid-template-columns: repeat(4, minmax(0, 1fr));
}

.prg-entry-card,
.prg-paper-card,
.prg-meta-card {
  background: linear-gradient(180deg, rgba(248, 250, 252, 0.98), rgba(241, 245, 249, 0.94));
  border: 1px solid rgba(148, 163, 184, 0.18);
  border-radius: 22px;
  box-shadow: 0 12px 30px rgba(15, 23, 42, 0.06);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.prg-entry-card:hover,
.prg-paper-card:hover,
.prg-meta-card:hover {
  box-shadow: 0 18px 36px rgba(15, 23, 42, 0.10);
  transform: translateY(-4px);
}

.prg-entry-card {
  color: var(--text-color);
  display: block;
  overflow: hidden;
  padding: 1.15rem;
}

.prg-entry-media {
  align-items: center;
  border-radius: 18px;
  color: rgba(255, 255, 255, 0.96);
  display: flex;
  font-weight: 600;
  height: 150px;
  justify-content: center;
  margin-bottom: 1rem;
}

.prg-entry-papers .prg-entry-media {
  background: linear-gradient(135deg, #f97316, #fb7185);
}

.prg-entry-topics .prg-entry-media {
  background: linear-gradient(135deg, #0ea5e9, #2563eb);
}

.prg-entry-tags .prg-entry-media {
  background: linear-gradient(135deg, #10b981, #14b8a6);
}

.prg-entry-about .prg-entry-media {
  background: linear-gradient(135deg, #8b5cf6, #a78bfa);
}

.prg-entry-card h3 {
  font-size: 1.35rem;
  margin-bottom: 0.5rem;
}

.prg-entry-card p {
  color: var(--second-text-color);
  line-height: 1.7;
}

.prg-meta-grid {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.prg-meta-card {
  padding: 1.4rem;
}

.prg-meta-card h3 {
  margin-bottom: 1rem;
}

.prg-chip-list {
  display: flex;
  flex-wrap: wrap;
  gap: 0.7rem;
}

.prg-chip {
  background: rgba(37, 99, 235, 0.08);
  border-radius: 999px;
  color: #1d4ed8;
  display: inline-flex;
  font-size: 0.95rem;
  padding: 0.5rem 0.9rem;
}

.prg-chip-tag {
  background: rgba(16, 185, 129, 0.10);
  color: #0f766e;
}

.prg-paper-grid {
  grid-template-columns: repeat(4, minmax(0, 1fr));
}

.prg-paper-card {
  overflow: hidden;
}

.prg-paper-cover {
  align-items: flex-start;
  background-color: #1e293b;
  background-position: center;
  background-repeat: no-repeat;
  background-size: cover;
  display: flex;
  height: 218px;
  justify-content: flex-start;
  padding: 1rem;
}

.prg-paper-cover-label {
  background: rgba(15, 23, 42, 0.54);
  border-radius: 999px;
  color: #fff;
  font-size: 0.82rem;
  padding: 0.35rem 0.75rem;
}

.prg-paper-body {
  padding: 1.1rem 1.1rem 1.2rem;
}

.prg-paper-taxonomy,
.prg-paper-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
}

.prg-paper-taxonomy a {
  background: rgba(59, 130, 246, 0.10);
  border-radius: 999px;
  color: #1d4ed8;
  font-size: 0.82rem;
  padding: 0.28rem 0.6rem;
}

.prg-paper-card h3 {
  font-size: 1.2rem;
  line-height: 1.45;
  margin: 0.9rem 0 0.55rem;
}

.prg-paper-reader {
  color: var(--second-text-color);
  font-size: 0.92rem;
  margin: 0 0 0.65rem;
}

.prg-paper-excerpt {
  color: var(--second-text-color);
  line-height: 1.7;
  min-height: 5.3em;
}

.prg-paper-tags {
  margin-top: 0.95rem;
}

.prg-paper-tags a {
  color: #475569;
  font-size: 0.85rem;
}

@media (max-width: 991px) {
  .site-nav-right {
    display: block;
  }

  .site-nav .menu-item-search {
    margin-left: 0;
    width: 100%;
  }

  .site-nav .menu-item-search .popup-trigger {
    min-width: 0;
    width: 100%;
  }

  .prg-site-nav {
    align-items: stretch;
    flex-direction: column;
  }

  .prg-nav-search {
    flex: none;
    width: 100%;
  }

  .prg-hero-card {
    grid-template-columns: 1fr;
  }

  .prg-entry-grid,
  .prg-paper-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 767px) {
  .prg-home {
    gap: 1.25rem;
  }

  .prg-section,
  .prg-hero-card {
    border-radius: 18px;
    padding: 1.2rem;
  }

  .prg-hero-card h1 {
    font-size: 2rem;
  }

  .prg-entry-grid,
  .prg-paper-grid,
  .prg-meta-grid {
    grid-template-columns: 1fr;
  }
}
